# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# ImageKit (CDN & Image Uploads)
NEXT_PUBLIC_PUBLIC_KEY="your_imagekit_public_key"
NEXT_PUBLIC_URL_ENDPOINT="https://ik.imagekit.io/your_id"
PRIVATE_KEY="your_imagekit_private_key"

# WhatsApp Configuration
# Mode can be 'link' (direct wa.me link) or 'api' (Meta Graph API)
NEXT_PUBLIC_WHATSAPP_MODE=link
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_RECIPIENT_PHONE=

# Admin Authentication
SESSION_SECRET="your_long_random_session_secret"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password

# Analytics & SEO Verification
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_PROJECT_ID="xxxxxxxx"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your_google_verification_code"
