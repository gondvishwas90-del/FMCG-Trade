### Component 3: Webhook Route (Enhanced)

#### [MODIFY] [route.ts](file:///c:/Users/DES%2002/Documents/Aditya/FMCG/fmcg-next-vercel/src/app/api/whatsapp/webhook/route.ts)

**Current state:** Only logs to console — no persistence.

**Changes:**
- Save incoming messages as new leads (from people who message the business directly)
- Update lead delivery status (`delivered`, `read`, `failed`) using `whatsappMessageId`

```typescript
import { NextResponse } from 'next/server';
import dbConnect from '@/lib/db';
import Lead from '@/models/Lead';

// ── GET: Webhook verification (unchanged) ──
export async function GET(req: Request) {
  const { searchParams } = new URL(req.url);
  const mode      = searchParams.get('hub.mode');
  const token     = searchParams.get('hub.verify_token');
  const challenge = searchParams.get('hub.challenge');

  const VERIFY_TOKEN = process.env.WHATSAPP_WEBHOOK_VERIFY_TOKEN;

  if (mode === 'subscribe' && token === VERIFY_TOKEN) {
    console.log('[Webhook] ✅ Verified');
    return new NextResponse(challenge, { status: 200 });
  } else {
    console.error('[Webhook] ❌ Verification failed');
    return new NextResponse('Forbidden', { status: 403 });
  }
}

// ── POST: Handle incoming events ──
export async function POST(req: Request) {
  try {
    const body = await req.json();

    if (body.object !== 'whatsapp_business_account') {
      return new NextResponse('Not Found', { status: 404 });
    }

    await dbConnect();

    for (const entry of body.entry || []) {
      for (const change of entry.changes || []) {
        const value = change.value;

        // ── Incoming messages ──
        if (value.messages) {
          for (const msg of value.messages) {
            const from    = msg.from;            // sender's phone number
            const msgBody = msg.text?.body || ''; // message text (if text type)
            const msgType = msg.type;             // text, image, document, etc.

            console.log(`[Webhook] Incoming ${msgType} from ${from}: ${msgBody}`);

            // Save as a new lead (direct WhatsApp message to business)
            await Lead.create({
              name: value.contacts?.[0]?.profile?.name || 'WhatsApp User',
              phone: from,
              message: msgBody || `[${msgType} message]`,
              source: 'whatsapp_widget',
              whatsappStatus: 'sent',
              whatsappMessageId: msg.id,
            });
          }
        }

        // ── Status updates (delivered, read, failed) ──
        if (value.statuses) {
          for (const status of value.statuses) {
            const messageId  = status.id;
            const newStatus  = status.status; // sent, delivered, read, failed

            console.log(`[Webhook] Status update: ${messageId} → ${newStatus}`);

            // Map Meta status to our schema
            const statusMap: Record<string, string> = {
              'sent': 'sent',
              'delivered': 'delivered',
              'read': 'read',
              'failed': 'failed',
            };

            const mappedStatus = statusMap[newStatus];
            if (mappedStatus && messageId) {
              await Lead.findOneAndUpdate(
                { whatsappMessageId: messageId },
                {
                  whatsappStatus: mappedStatus,
                  ...(newStatus === 'failed' ? {
                    whatsappError: status.errors?.[0]?.title || 'Delivery failed'
                  } : {})
                }
              );
            }
          }
        }
      }
    }

    // Always return 200 quickly to prevent Meta retries
    return NextResponse.json({ status: 'ok' }, { status: 200 });
  } catch (error) {
    console.error('[Webhook] Error:', error);
    // Still return 200 — otherwise Meta will keep retrying
    return NextResponse.json({ status: 'error' }, { status: 200 });
  }
}
```

> [!NOTE]
> The POST error handler returns `200` intentionally. If we return `500`, Meta retries the same event repeatedly, causing duplicate leads and flooding logs.

