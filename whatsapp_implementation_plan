### Component 2: Send API Route (Complete Rewrite)

#### [MODIFY] [route.ts](file:///c:/Users/DES%2002/Documents/Aditya/FMCG/fmcg-next-vercel/src/app/api/whatsapp/send/route.ts)

**Current problems:**
1. Tries free-form text message first → always fails (24-hour window never open)
2. Falls back to `hello_world` template with zero parameters → support team gets "Hello World" with no context
3. No lead persistence → leads are lost on failure
4. No meaningful error responses

**New approach (complete replacement):**

```typescript
import { NextResponse } from 'next/server';
import dbConnect from '@/lib/db';
import Lead from '@/models/Lead';

interface SendRequest {
  message: string;
  name?: string;
  userPhone?: string;
}

export async function POST(req: Request) {
  try {
    const body: SendRequest = await req.json();
    const { message, name, userPhone } = body;

    // ── 1. Validate input ──
    if (!message?.trim()) {
      return NextResponse.json({ error: 'Message is required' }, { status: 400 });
    }

    // ── 2. Save lead to MongoDB FIRST (never lose a lead) ──
    await dbConnect();
    const lead = await Lead.create({
      name: name?.trim() || 'Unknown',
      phone: userPhone?.trim() || 'Not provided',
      message: message.trim(),
      source: 'whatsapp_widget',
      whatsappStatus: 'pending',
    });
    console.log('[WhatsApp] Lead saved to MongoDB:', lead._id);

    // ── 3. Load & validate configuration ──
    const PHONE_NUMBER_ID = process.env.WHATSAPP_PHONE_NUMBER_ID?.trim();
    const ACCESS_TOKEN    = process.env.WHATSAPP_ACCESS_TOKEN?.trim();
    const RECIPIENT_PHONE = process.env.WHATSAPP_RECIPIENT_PHONE?.trim();
    const TEMPLATE_NAME   = process.env.WHATSAPP_TEMPLATE_NAME?.trim() || 'hello_world';

    if (!PHONE_NUMBER_ID || !ACCESS_TOKEN || !RECIPIENT_PHONE) {
      console.warn('[WhatsApp] Missing API configuration — lead saved but message not sent');
      return NextResponse.json({
        success: true,
        leadId: lead._id,
        whatsappSent: false,
        reason: 'WhatsApp API not configured. Lead has been saved.',
      });
    }

    // ── 4. Build API request ──
    const apiUrl = `https://graph.facebook.com/v23.0/${PHONE_NUMBER_ID}/messages`;
    const headers = {
      'Authorization': `Bearer ${ACCESS_TOKEN}`,
      'Content-Type': 'application/json',
    };

    // ── 5. Build template payload ──
    // Construct wa.me reply link for support team to click
    const cleanPhone = (userPhone || '').replace(/[^0-9]/g, '');
    const replyLink  = cleanPhone ? `https://wa.me/${cleanPhone}` : 'Not provided';

    let payload: Record<string, any>;

    if (TEMPLATE_NAME === 'hello_world') {
      // hello_world has NO parameters — just sends "Hello World"
      payload = {
        messaging_product: 'whatsapp',
        to: RECIPIENT_PHONE,
        type: 'template',
        template: {
          name: 'hello_world',
          language: { code: 'en_US' },
        },
      };
    } else {
      // Custom template with 4 parameters: {{1}}=name, {{2}}=phone, {{3}}=message, {{4}}=replyLink
      payload = {
        messaging_product: 'whatsapp',
        to: RECIPIENT_PHONE,
        type: 'template',
        template: {
          name: TEMPLATE_NAME,
          language: { code: 'en_US' },
          components: [
            {
              type: 'body',
              parameters: [
                { type: 'text', text: name?.trim() || 'Unknown' },
                { type: 'text', text: userPhone?.trim() || 'Not provided' },
                { type: 'text', text: message.trim().substring(0, 500) },
                { type: 'text', text: replyLink },
              ],
            },
          ],
        },
      };
    }

    // ── 6. Send to Meta ──
    console.log(`[WhatsApp] Sending template "${TEMPLATE_NAME}" to ${RECIPIENT_PHONE}...`);
    const response = await fetch(apiUrl, {
      method: 'POST',
      headers,
      body: JSON.stringify(payload),
    });
    const data = await response.json();

    if (response.ok) {
      // Update lead with success status
      const messageId = data?.messages?.[0]?.id || '';
      await Lead.findByIdAndUpdate(lead._id, {
        whatsappStatus: TEMPLATE_NAME === 'hello_world' ? 'template_sent' : 'sent',
        whatsappMessageId: messageId,
      });
      console.log(`[WhatsApp] ✅ Message sent. ID: ${messageId}`);

      return NextResponse.json({
        success: true,
        leadId: lead._id,
        whatsappSent: true,
        messageId,
      });
    } else {
      // Update lead with failure
      const errorMsg = data?.error?.message || 'Unknown Meta API error';
      await Lead.findByIdAndUpdate(lead._id, {
        whatsappStatus: 'failed',
        whatsappError: errorMsg,
      });
      console.error(`[WhatsApp] ❌ API Error:`, data?.error);

      return NextResponse.json({
        success: true,        // Lead is still saved!
        leadId: lead._id,
        whatsappSent: false,
        reason: errorMsg,
      }, { status: 200 });    // 200 because the lead IS saved, just WhatsApp failed
    }

  } catch (error) {
    console.error('[WhatsApp] Internal error:', error);
    return NextResponse.json(
      { error: 'Internal Server Error', whatsappSent: false },
      { status: 500 }
    );
  }
}
```

**Key design decisions:**
- **Lead saved BEFORE API call** — even if Meta is completely down, the lead is in MongoDB
- **Returns `success: true` even if WhatsApp fails** — because the lead IS captured; frontend shows "message received" either way
- **Supports both `hello_world` (no params) and custom template (with params)** — so it works during the transition period before your custom template is approved
- **Message truncated to 500 chars** — Meta template parameters have length limits
- **Updates lead status after API response** — for tracking in admin panel later

